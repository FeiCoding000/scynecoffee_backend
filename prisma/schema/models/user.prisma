enum UserRole {
  ADMIN
  BARISTA
  STAFF
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id          String     @id @default(uuid())
  firebaseUid String?    @unique @map("firebase_uid")
  email       String?    @unique
  googleEmail String?    @unique @map("google_email")
  displayName String     @map("display_name")
  role        UserRole
  status      UserStatus @default(ACTIVE)
  isActivated             Boolean    @default(false) @map("is_activated")
  isProfileSetupCompleted Boolean    @default(false) @map("is_profile_setup_completed")
  activatedAt             DateTime?  @map("activated_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  claimedActivationCodes ActivationCode[]
  preferredDrinks         PreferredDrink[]

  @@map("users")
}
